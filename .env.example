# ============================================================================
#  PKS configuration  —  copy this file to `.env`, edit the REQUIRED values,
#  then run `pks`.  Nothing else is needed to start.
#      cp .env.example .env && nano .env
# ============================================================================

# ---- LLM endpoint (REQUIRED) -----------------------------------------------
# PKS does NOT ship a model. It uses the OpenAI Chat Completions protocol.
# Point the two lines below at your OpenAI or OpenAI-compatible endpoint.
OPENAI_API_KEY="sk-REPLACE_ME"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Model name your endpoint serves (exactly as your gateway routes it).
PKS_MODEL="gpt-5.6-terra"

# ---- Runtime (recommended defaults — fine to leave as-is) -------------------
PKS_STREAM=true            # stream the model's output as it generates
PKS_TUI=false              # use the compact terminal REPL (not the heavy TUI)
PKS_TELEMETRY=false        # no telemetry
PKS_COMPACT_REPL=0         # 0 = show tool output inline; 1 = collapse into pills
PKS_CYBER_PROFILE_MODE=lite   # cyber baseline size: lite | full | off

# ---- Optional tuning (uncomment only if you need it) -----------------------
# PKS_REASONING_EFFORT=high          # off | low | medium | high | xhigh | max
# PKS_MODEL_MAX_INPUT_TOKENS=1000000  # force context window if your model isn't auto-detected
# PKS_CHARS_PER_TOKEN=3.0             # fast token-estimate divisor (lower = compact earlier/safer)
# PKS_TOOL_OUTPUT_MAX=20000           # cap tool output stored in LLM memory (UI has its own limit)
# PKS_BB_FILE=~/.pks/blackboard.json  # shared blackboard file (set per-instance for parallel runs)
# PKS_FETCH_ALLOW_INTERNAL=false      # let fetch_url reach internal hosts — AUTHORIZED pentest only
